<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows release packages.

  SignPath does not read this file from the repository: paste it into the SignPath project
  as the artifact configuration with slug "installers". It is kept here so that changes are
  reviewed together with the workflow (.github/workflows/windows-release.yml).

  The GitHub artifact submitted by the workflow is a ZIP containing one CPack ZIP and one
  CPack MSI (AtmoSwing-<desktop|server>-<version>-win64.*). SignPath deep-signs both:
  the AtmoSwing executables inside each package are signed, then the MSI itself.
  Third-party DLLs (wxWidgets, GDAL, eccodes, ...) are intentionally left untouched:
  SignPath Foundation only signs binaries built from this project's sources.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1"
                        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                        xsi:schemaLocation="http://signpath.io/artifact-configuration/v1 https://app.signpath.io/Web/artifact-configuration/v1.xsd">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <msi-file path="AtmoSwing-*-${version}-win64.msi">
      <pe-file-set product-name="AtmoSwing" product-version="${version}" original-filename="${file.name}">
        <include path="**/atmoswing-*.exe" max-matches="unbounded" />
        <for-each>
          <authenticode-sign />
        </for-each>
      </pe-file-set>
      <authenticode-sign />
    </msi-file>
    <zip-file path="AtmoSwing-*-${version}-win64.zip">
      <pe-file-set product-name="AtmoSwing" product-version="${version}" original-filename="${file.name}">
        <include path="**/atmoswing-*.exe" max-matches="unbounded" />
        <for-each>
          <authenticode-sign />
        </for-each>
      </pe-file-set>
    </zip-file>
  </zip-file>
</artifact-configuration>
